DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="change-me-to-a-long-random-string"

# Absolute base URL used to build lecturer invite links. Falls back to the
# incoming request's origin, which is fine locally but wrong behind a proxy.
APP_URL="https://lecbook.example.com"

# Seeded development accounts, used by `npm run db:seed:creds`.
# Leave any password unset and the seed generates a random one and prints it once.
SEED_SUPERADMIN_EMAIL="dev@example.com"
SEED_SUPERADMIN_PASSWORD=""
SEED_SUPERADMIN_NAME="Super Admin"

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="College Administrator"

SEED_LECTURER_EMAIL="lecturer@example.com"
SEED_LECTURER_PASSWORD=""
SEED_LECTURER_NAME="Lecturer"
