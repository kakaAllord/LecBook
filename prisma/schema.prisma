generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Settings {
  id                  String   @id @default(cuid())
  institutionName     String   @default("Your Institution Name")
  institutionLogo     String?
  attendanceThreshold Float    @default(75)
  assessmentPassMark  Float    @default(50)
  updatedAt           DateTime @updatedAt
}

model Course {
  id           String   @id @default(cuid())
  name         String
  level        String
  semester     String
  academicYear String
  createdAt    DateTime @default(now())

  students    Student[]
  modules     Module[]     @relation("ModuleCourses")
  assessments Assessment[] @relation("AssessmentCourses")
}

model Module {
  id        String   @id @default(cuid())
  name      String
  code      String?
  createdAt DateTime @default(now())

  courses     Course[]     @relation("ModuleCourses")
  attendance  Attendance[]
  assessments Assessment[]
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model Student {
  id                 String        @id @default(cuid())
  registrationNumber String        @unique
  fullName           String
  gender             String
  phone              String?
  courseId           String
  status             StudentStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())

  course     Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  attendance Attendance[]
  marks      AssessmentMark[]

  @@index([courseId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  moduleId  String
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId, date])
  @@index([date])
  @@index([moduleId])
}

model Assessment {
  id        String   @id @default(cuid())
  moduleId  String
  name      String
  maxMarks  Float
  date      DateTime
  createdAt DateTime @default(now())

  module  Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courses Course[]         @relation("AssessmentCourses")
  marks   AssessmentMark[]

  @@index([moduleId])
}

model AssessmentMark {
  id           String  @id @default(cuid())
  assessmentId String
  studentId    String
  marks        Float
  remarks      String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
}
