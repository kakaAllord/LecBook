generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  LECTURER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  // Null until an invited user accepts their invite and sets a password.
  password  String?
  role      UserRole   @default(LECTURER)
  status    UserStatus @default(ACTIVE)
  phone     String?
  title     String?
  staffId   String?
  // The admin (or super admin) who created this account.
  createdById String?
  lastLoginAt DateTime?
  loginCount  Int      @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  createdBy    User?  @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreator")

  // Lecturers are assigned modules; the courses (and therefore the students)
  // they see are derived from those modules.
  modules  Module[] @relation("ModuleLecturers")

  invites    Invite[]
  sessions   UserSession[]
  auditLogs  AuditLog[]
  attendance Attendance[]

  @@index([role])
  @@index([createdById])
}

model Invite {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  createdById String?
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

model UserSession {
  id         String     @id @default(cuid())
  userId     String
  ip         String?
  userAgent  String?
  deviceType DeviceType @default(UNKNOWN)
  browser    String?
  os         String?
  createdAt  DateTime   @default(now())
  lastSeenAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([lastSeenAt])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  // Denormalized so the trail survives the actor being deleted.
  actorName  String
  actorEmail String
  actorRole  UserRole
  action     String
  entity     String
  entityId   String?
  summary    String
  metadata   Json?
  ip         String?
  userAgent  String?
  // Set when a super admin performed this while viewing as another user.
  impersonatedById String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([entity])
}

model Settings {
  id                  String   @id @default(cuid())
  institutionName     String   @default("Your Institution Name")
  institutionLogo     String?
  attendanceThreshold Float    @default(75)
  assessmentPassMark  Float    @default(50)
  updatedAt           DateTime @updatedAt
}

model Course {
  id           String   @id @default(cuid())
  name         String
  level        String
  semester     String
  academicYear String
  createdAt    DateTime @default(now())

  students    Student[]
  modules     Module[]     @relation("ModuleCourses")
  assessments Assessment[] @relation("AssessmentCourses")
}

model Module {
  id        String   @id @default(cuid())
  name      String
  code      String?
  createdAt DateTime @default(now())

  courses     Course[]     @relation("ModuleCourses")
  attendance  Attendance[]
  assessments Assessment[]
  lecturers   User[]       @relation("ModuleLecturers")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model Student {
  id                 String        @id @default(cuid())
  registrationNumber String        @unique
  fullName           String
  gender             String
  phone              String?
  courseId           String
  status             StudentStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())

  course     Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  attendance Attendance[]
  marks      AssessmentMark[]

  @@index([courseId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  moduleId  String
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  // The lecturer/admin who last saved this record.
  recordedById String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module     Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, moduleId, date])
  @@index([date])
  @@index([moduleId])
  @@index([recordedById])
}

model Assessment {
  id        String   @id @default(cuid())
  moduleId  String
  name      String
  maxMarks  Float
  date      DateTime
  createdAt DateTime @default(now())

  module  Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courses Course[]         @relation("AssessmentCourses")
  marks   AssessmentMark[]

  @@index([moduleId])
}

model AssessmentMark {
  id           String  @id @default(cuid())
  assessmentId String
  studentId    String
  marks        Float
  remarks      String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
}
