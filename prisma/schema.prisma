generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  LECTURER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model User {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  // Null until an invited user accepts their invite and sets a password.
  password            String?
  role                UserRole   @default(LECTURER)
  status              UserStatus @default(ACTIVE)
  phone               String?
  title               String?
  staffId             String?
  // The admin (or super admin) who created this account.
  createdById         String?
  // A lecturer sets the bar for their own modules; null means the institution
  // default in Settings applies.
  attendanceThreshold Float?
  assessmentPassMark  Float?
  lastLoginAt         DateTime?
  loginCount          Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @default(now()) @updatedAt

  createdBy    User?  @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreator")

  // What a lecturer teaches: a module, at a level, to particular courses. The
  // students they see are derived from these rows and nothing else.
  teachingAssignments TeachingAssignment[]

  invites    Invite[]
  sessions   UserSession[]
  auditLogs  AuditLog[]
  attendance Attendance[]

  @@index([role])
  @@index([createdById])
}

model Invite {
  id          String    @id @default(cuid())
  token       String    @unique
  userId      String
  createdById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

model UserSession {
  id         String     @id @default(cuid())
  userId     String
  ip         String?
  userAgent  String?
  deviceType DeviceType @default(UNKNOWN)
  browser    String?
  os         String?
  createdAt  DateTime   @default(now())
  lastSeenAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([lastSeenAt])
}

model AuditLog {
  id               String   @id @default(cuid())
  userId           String?
  // Denormalized so the trail survives the actor being deleted.
  actorName        String
  actorEmail       String
  actorRole        UserRole
  action           String
  entity           String
  entityId         String?
  summary          String
  metadata         Json?
  ip               String?
  userAgent        String?
  // Set when a super admin performed this while viewing as another user.
  impersonatedById String?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([entity])
}

model Settings {
  id                  String   @id @default(cuid())
  institutionName     String   @default("Your Institution Name")
  institutionLogo     String?
  attendanceThreshold Float    @default(75)
  assessmentPassMark  Float    @default(60)
  updatedAt           DateTime @updatedAt
}

// A course is what a student enrols on when they arrive and stays with them
// until they leave, so it carries nothing that changes year to year. Adding a
// course also adds its core module, which carries the same name.
model Course {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  students            Student[]
  coreModule          Module?              @relation("CoreModule")
  assessments         Assessment[]         @relation("AssessmentCourses")
  teachingAssignments TeachingAssignment[]
}

enum ModuleKind {
  CORE
  RELATED
}

// Two kinds of module:
// - CORE: one per course, named after it, taught to that course at every level
//   from I to III. `courseId` is set and `level` is null.
// - RELATED: belongs to one level and is taught to every course at that level.
//   `level` is set (1–3) and `courseId` is null.
// The database enforces that pairing with a check constraint.
model Module {
  id        String     @id @default(cuid())
  name      String
  code      String?
  kind      ModuleKind @default(RELATED)
  courseId  String?    @unique
  level     Int?
  createdAt DateTime   @default(now())

  course      Course?              @relation("CoreModule", fields: [courseId], references: [id], onDelete: Cascade)
  attendance  Attendance[]
  assessments Assessment[]
  assignments TeachingAssignment[]
}

// One row per lecturer, module, level and course they teach it to. A lecturer
// assigned a related module for "all courses" has one row per course; that
// keeps every scope check a plain lookup.
model TeachingAssignment {
  id         String   @id @default(cuid())
  lecturerId String
  moduleId   String
  level      Int
  courseId   String
  createdAt  DateTime @default(now())

  lecturer User   @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, moduleId, level, courseId])
  @@index([moduleId, level])
  @@index([courseId, level])
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  // Passed Level III. Kept on the roll for their records, off every register.
  COMPLETED
}

model Student {
  id                 String        @id @default(cuid())
  registrationNumber String        @unique
  fullName           String
  gender             String
  phone              String?
  courseId           String
  // Level of study, 1–3 (shown as I–III). Starts at I and moves up when the
  // administrator promotes the students who passed.
  level              Int           @default(1)
  status             StudentStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())

  course     Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  attendance Attendance[]
  marks      AssessmentMark[]

  @@index([courseId])
  @@index([courseId, level])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  id           String           @id @default(cuid())
  studentId    String
  moduleId     String
  // The level the session was taught at. Recorded rather than read from the
  // students so a register still means the same thing after they move up.
  level        Int
  date         DateTime
  status       AttendanceStatus
  remarks      String?
  // The lecturer/admin who last saved this record.
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module     Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, moduleId, date])
  @@index([date])
  @@index([moduleId])
  @@index([moduleId, level])
  @@index([recordedById])
}

model Assessment {
  id        String   @id @default(cuid())
  moduleId  String
  // The level it was set at; a core module is assessed separately at each.
  level     Int
  name      String
  maxMarks  Float
  date      DateTime
  createdAt DateTime @default(now())

  module  Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courses Course[]         @relation("AssessmentCourses")
  marks   AssessmentMark[]

  @@index([moduleId])
  @@index([moduleId, level])
}

model AssessmentMark {
  id           String  @id @default(cuid())
  assessmentId String
  studentId    String
  marks        Float
  remarks      String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
}
